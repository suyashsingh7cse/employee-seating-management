# Flask
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_ENV=development

# Admin login (Phase 1 auth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Database
# In dev this resolves to a local file. In Railway prod, point this at the
# persistent volume mount path (see Phase 6 notes).
DATABASE_PATH=instance/seating.db

# Gemini (added in Phase 3 — not used yet)
GEMINI_API_KEY=PASTE_YOUR_ACTUAL_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash
